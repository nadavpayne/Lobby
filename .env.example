# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_...). Safe in the browser; used for resident/admin login.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Server only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional, local only: base URL that `npm run seed:demo` prints the demo link with. Not needed on Vercel
# (the app builds links from the address each request comes in on).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Signs business terminal device tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUSINESS_TOKEN_SECRET=
# The only account allowed into /admin (create it in Supabase: Authentication -> Users -> Add user).
ADMIN_EMAIL=
