# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_...). Safe in the browser; used for resident/admin login.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Server only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional, local only: base URL that `npm run seed:demo` prints the demo link with. Not needed on Vercel
# (the app builds links from the address each request comes in on).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Signs business terminal device tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUSINESS_TOKEN_SECRET=
# Admins are rows in the user_roles table (role = admin). npm run seed:dev gives this email that role.
ADMIN_EMAIL=

# ---- Dev database only: put these in .env.dev.local together with the dev project's URL and keys. ----
# npm run seed:dev WIPES that database and refills it with the Petah Tikva demo. Refuses without SEED_TARGET=dev.
# SEED_TARGET=dev
# Optional: your own emails, so you can sign in as the owner of the first business / as building 1's committee.
# SEED_OWNER_EMAIL=
# SEED_RESIDENT_EMAIL=

# Google Maps (address lookup + maps). Leave empty to keep plain address fields. See README "Addresses and maps".
# Server key: Places API (New) only. Web key: Maps JavaScript API only, restricted to the site's URLs.
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=
